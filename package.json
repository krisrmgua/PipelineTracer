{
  "name": "pipeline-tracer",
  "productName": "Pipeline Tracer",
  "version": "0.3.25",
  "description": "Tray app for your GitLab and GitHub pipelines, merge requests, and pull requests, for macOS and Windows",
  "main": "dist-electron/main.js",
  "author": "Kristopher Simmons",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "icons": "node scripts/make-icon.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json",
    "check": "npm run build:electron && node dist-electron/selfcheck.js",
    "build:notify-helper": "bash menubar/make-app.sh",
    "build": "npm run typecheck && npm run build:ui && npm run build:electron && npm run icons",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && PIPELINE_TRACER_DEV=1 PIPELINE_TRACER_DEV_SERVER=http://127.0.0.1:5173 electron .\"",
    "pack:mac": "npm run build && npm run build:notify-helper && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack": "npm run build && npm run build:notify-helper && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.kris.pipelinetracer",
    "productName": "Pipeline Tracer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/selfcheck.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ],
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "menubar/Pipeline Tracer.app",
          "to": "NotificationPreview.app",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0"
  }
}
